/* B 里品牌绿只出现在三处；TDesign 自身的 brand 退成中性灰，避免链接/加载/图标变绿。 */
.td-dark {
  --td-brand-color: #3F423F;
  --td-brand-color-active: #4A4D4A;
  --td-brand-color-disabled: #2E302E;
  --td-brand-color-focus: #353835;
  --td-brand-color-light: #2A2C2A;
  --td-brand-color-light-active: #303330;
  --td-primary-color-1: #2A2C2A;
  --td-primary-color-2: #303330;
  --td-primary-color-3: #2E302E;
  --td-primary-color-8: #3F423F;
  --td-primary-color-9: #4A4D4A;
  --td-text-color-brand: var(--b-w2);
  --td-text-color-link: var(--b-w2);
  --td-button-border-radius: 28rpx;
  --td-button-large-height: 112rpx;
  --td-button-large-font: 500 28rpx / 44rpx -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  --td-popup-bg-color: transparent;
}

/* 唯一允许品牌绿的主按钮：圆角 14 / 高 56 / 字 14。 */
.btn-green {
  --td-button-primary-bg-color: var(--b-green);
  --td-button-primary-border-color: var(--b-green);
  --td-button-primary-active-bg-color: #406B4E;
  --td-button-primary-active-border-color: #406B4E;
  --td-button-primary-color: #FFFFFF;
}

/* 玻璃按钮：rgba(255,255,255,.16) 底 + .34 边 + 顶部内高光。 */
.btn-glass.t-button {
  background-color: rgba(255, 255, 255, 0.16);
  border-color: rgba(255, 255, 255, 0.34);
  color: var(--b-w1);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), var(--b-shadow-btn);
}

.btn-glass.t-button::after {
  border-color: rgba(255, 255, 255, 0.34);
}

/* 支持模糊的机型，玻璃按钮也吃同一套 blur。 */
.glass-on .btn-glass.t-button {
  -webkit-backdrop-filter: blur(18px) saturate(120%);
  backdrop-filter: blur(18px) saturate(120%);
}

.btn-glass.t-button--hover {
  background-color: rgba(255, 255, 255, 0.22);
}
