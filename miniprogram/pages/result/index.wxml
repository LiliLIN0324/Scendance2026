<view class="page td-dark {{glassClass}} {{state === 'failed' ? 'page--fail' : state === 'done' ? '' : 'page--center'}}">
  <!-- 09 底图：场地照片虚化压暗，只在上传/重建中露出。 -->
  <image
    wx:if="{{state === 'preparing' || state === 'queued' || state === 'processing'}}"
    class="backdrop"
    src="/assets/guide/bg-a.jpg"
    mode="aspectFill"
  />
  <view class="b-vig-mid layer"></view>
  <view class="b-noise layer"></view>

  <!-- 09：缩略 → 标题 → 通栏进度 → 约 X 分 / 可后台；40 秒不动换一句「还在重试」。 -->
  <view
    class="card progress-card b-glass {{stalled ? 'is-stalled' : ''}}"
    wx:if="{{state === 'preparing' || state === 'queued' || state === 'processing'}}"
    bindlongpress="onDebugFail"
  >
    <image class="progress-thumb" src="/assets/guide/album-thumb.jpg" mode="aspectFill" />
    <text class="progress-title">{{stateLabel}}</text>
    <view class="bar">
      <view class="bar__fill" style="width:{{progress}}%;"></view>
    </view>
    <view class="progress-foot">
      <text class="progress-eta">{{etaText}}</text>
      <text class="progress-eta">可后台</text>
    </view>
    <text class="progress-note {{stalled ? 'is-warn' : ''}}">{{runNote}}</text>
  </view>

  <!-- 成功：2×2 预览 + 尺寸 + 两个产物，复制链接钉在底部 -->
  <block wx:if="{{state === 'done'}}">
    <view class="back" bindtap="onExit">
      <t-icon name="chevron-left" size="48rpx" color="rgba(255,255,255,0.72)" />
    </view>

    <view class="preview-grid" wx:if="{{previewUrls.length}}">
      <image class="preview" wx:for="{{previewUrls}}" wx:key="*this" src="{{item}}" mode="aspectFill" />
    </view>

    <view class="card b-glass">
      <view class="size" wx:if="{{size}}">
        <text class="size__num">{{size.w}} × {{size.d}} × {{size.h}}</text>
        <text class="size__unit">{{size.unit}}</text>
      </view>
      <text class="note" wx:if="{{upAxis}}">{{upAxis}} 轴向上 · {{normalized ? '已归一化' : '未归一化'}}</text>

      <view class="artifacts">
        <view class="artifact" hover-class="artifact--down" bindtap="onShareModelFile">
          <t-icon name="view-module" size="44rpx" color="rgba(255,255,255,0.8)" />
          <text class="artifact__label">GLB</text>
        </view>
        <view class="artifact" hover-class="artifact--down" bindtap="rawUrl ? onCopyRaw : onCopyModel">
          <t-icon name="file-copy" size="44rpx" color="rgba(255,255,255,0.8)" />
          <text class="artifact__label">原件</text>
        </view>
      </view>
    </view>

    <view class="spacer"></view>
    <view class="link">
      <t-button theme="primary" size="large" block t-class="btn-green" bind:tap="onCopyLink">复制链接</t-button>
    </view>
  </block>

  <!-- 失败：卡在哪 + 还要多久 + 现在能做什么；返还情况写在同一张卡上。 -->
  <view class="card fail b-glass" wx:if="{{state === 'failed'}}">
    <text class="fail__title">{{failTitle}}</text>
    <text class="fail__cause">{{failCause}}</text>
    <text class="fail__eta">{{failEta}}</text>
    <text wx:if="{{refundText}}" class="fail__refund">{{refundText}}</text>
    <view class="fail__actions">
      <t-button
        wx:if="{{canRetry}}"
        theme="primary"
        size="large"
        block
        t-class="btn-green"
        bind:tap="onRetry"
      >{{failAction}}</t-button>
      <view class="fail__exit" bindtap="onExit">
        <text>先退出</text>
      </view>
    </view>
  </view>
</view>
