page {
  background: #0B0C0B;
}

.page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 24rpx calc(env(safe-area-inset-bottom) + 32rpx);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  background: linear-gradient(180deg, #0C0D0C 0%, #151614 100%);
  overflow: hidden;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

/* 11 / 13：失败态用径向黑底，不拿场地照片撒谎。 */
.page--fail {
  background: radial-gradient(120% 90% at 50% 32%, #151715 0%, #0A0B0A 62%, #070807 100%);
}

/* 09 底图：场内照片 blur(16px) + brightness(.42)，边缘外扩 24px 遮住虚化毛边。 */
.backdrop {
  position: absolute;
  top: -24px;
  left: -24px;
  width: calc(100% + 48px);
  height: calc(100% + 48px);
  pointer-events: none;
  filter: blur(16px) brightness(.42);
}

.layer {
  z-index: 0;
}

.head,
.card,
.preview-grid,
.link,
.fail {
  position: relative;
  z-index: 1;
}

.head {
  padding: 16rpx 8rpx 0;
}

.card {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  --td-cell-bg-color: transparent;
  --td-cell-border-color: rgba(255, 255, 255, 0.1);
  --td-cell-hover-color: rgba(255, 255, 255, 0.06);
  --td-cell-group-border-color: rgba(255, 255, 255, 0.1);
  --td-cell-left-icon-color: var(--b-w2);
  --td-cell-right-icon-color: var(--b-w3);
  --td-loading-color: var(--b-w2);
}

.card .t-cell__title-text {
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 500;
}

.note {
  font-size: 24rpx;
  line-height: 1.7;
  font-weight: 400;
  color: var(--b-w3);
}

.progress-card {
  gap: 24rpx;
}

.progress-thumb {
  display: block;
  width: 192rpx;
  height: 144rpx;
  border-radius: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.progress-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.progress-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.progress-num {
  font-size: 48rpx;
  line-height: 1.42;
  font-weight: 500;
  color: var(--b-w1);
}

.progress-pct {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--b-w3);
}

.preview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.preview {
  width: 100%;
  height: 312rpx;
  border-radius: 18px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: #1a1c1a;
}

.size {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
}

.size__num {
  font-size: 48rpx;
  line-height: 1.42;
  font-weight: 500;
  color: var(--b-w1);
}

.size__unit {
  padding-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--b-w3);
}

.link {
  display: flex;
}

.fail {
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.fail__title {
  font-size: 48rpx;
  line-height: 1.42;
  font-weight: 500;
  color: var(--b-amber);
}
