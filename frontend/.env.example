# Only public client configuration goes here. Copy to .env.local after deployment.
NEXT_PUBLIC_SUPABASE_URL=https://wkhfvnzgopjdzxlmycks.supabase.co
# New Supabase projects issue a publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name; only needed if the project still uses an anon JWT key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Historical HY3 asset viewer only; new models use DeepSeek parameter tools.
NEXT_PUBLIC_GENERATION_ENABLED=false
# Never put a service-role key, AI provider key or worker secret in NEXT_PUBLIC_*.
