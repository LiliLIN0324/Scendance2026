# Local CLI fills SUPABASE_* automatically for Edge Functions.
# For seed-demo and a standalone runtime, copy values from `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Leave unconfigured until account/API pricing is verified. No fake fallback.
DEEPSEEK_API_KEY=
# Cents reserved per request, covering BOTH possible model calls (including repair).
AI_MAX_REQUEST_CENTS=
HUNYUAN_API_KEY=
# New Tencent accounts use TokenHub. Use legacy only for an existing ai3d API key.
HUNYUAN_API_MODE=tokenhub
GENERATION_MAX_TASK_CENTS=
HUNYUAN_TERMS_URL=
HUNYUAN_TERMS_REVIEWED_AT=
# Aholo Lux3D (docs/15-Aholo集成规划.md M1). Optional second cloud vendor; requests must
# explicitly declare provider:'aholo' to enter that lane. Key from labs.aholo.ai/api-keys.
LUX3D_API_KEY=
LUX3D_TERMS_URL=
LUX3D_TERMS_REVIEWED_AT=
# Optional API gateway override; default https://api.aholo.ai/global
LUX3D_BASE_URL=
# Generate a random 32-byte token; separate from all API keys.
GENERATION_WORKER_SECRET=

# Independent floorplan preview: npm run dev:floorplan (uses only local PGlite).
# Provider keys remain server-only. No SUPABASE_* value is used by that runner.
RECONSTRUCTION_MAX_REQUEST_CENTS=200
RECONSTRUCTION_WORKER_SECRET=
SCENDANCE_DEV_DATA=.local-dev/floorplan
SCENDANCE_DEV_API_PORT=54336
SCENDANCE_DEV_WEB_PORT=3026

# Local demo bootstrap only. No built-in account/password.
DEMO_STUDIO_ID=
DEMO_STUDIO_NAME=演示活动工作室
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=

# DeepSeek Agent: tool loop default; legacy is a reversible proposal-flow fallback.
DEEPSEEK_AGENT_MODE=tools
HY3_RETIRED=true
# Chat (agent loop + brief extract): any OpenAI-compatible provider → Tokendance gateway →
# DeepSeek official endpoint above (same key as reconstruction). Switching providers is a
# `supabase secrets set` away and takes effect immediately, no redeploy.
AGENT_CHAT_BASE_URL=
AGENT_CHAT_KEY=
AGENT_CHAT_MODEL=
TOKENDANCE_API_KEY=

# Optional separate Bailian provider for brief extraction and read-only chat.
# Disabled by default; Agent tool runs and other workflows keep their existing provider.
# Set the key only in server-side secret management, never in NEXT_PUBLIC_* or the repository.
BAILIAN_PRODUCT_ENABLED=0
BAILIAN_PRODUCT_BASE_URL=
BAILIAN_PRODUCT_KEY=
BAILIAN_PRODUCT_MODEL=

# MiniMax (OpenAI-compatible, e.g. https://api.minimax.cn/v1) reuses the AGENT_CHAT_* slot:
# set AGENT_CHAT_PROFILE=minimax and MINIMAX_AGENT_TOOLS_ENABLED=1 to also drive the agent
# tool loop. Server-side secrets only, never in NEXT_PUBLIC_* or the repository.
AGENT_CHAT_PROFILE=
MINIMAX_AGENT_TOOLS_ENABLED=0

# —— 按次重建（支付宝 AI 付 / Vibe Pay，pay-api Edge Function）——
# 下面三项都是【敏感值】：只放本地 .env.local 或 `supabase secrets set`，
# 不要写进代码、日志、前端 NEXT_PUBLIC_* 或聊天记录。
ALIPAY_APP_ID=
# 应用私钥：必须是 PKCS#8（-----BEGIN PRIVATE KEY-----），RSA1 的 PKCS#1 不受支持。
ALIPAY_PRIVATE_KEY=
# 支付宝公钥：在开放平台上传应用公钥后由平台生成，用于回调与响应验签。
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
# 1 = 走沙盒网关（openapi-sandbox.dl.alipaydev.com），不产生真实扣款。
ALIPAY_SANDBOX=
# 可选：显式覆盖网关地址，留空按沙盒/正式自动选择。
ALIPAY_GATEWAY=
# 1 = 强制本地 mock（不请求支付宝，界面显示「模拟支付」）。
PAY_MOCK=
# 同一匿名设备每天最多几次重建（默认 3）。
PAY_DAILY_JOB_LIMIT=
# 前端可见值，不是密钥：pay-api 的函数地址与强制 mock 开关。
NEXT_PUBLIC_PAY_API_BASE=
NEXT_PUBLIC_PAY_MOCK=

