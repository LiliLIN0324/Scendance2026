# R2 上传凭据模板 —— 复制成 .r2.env 后填写，切勿提交。
#
# 获取方式（在已登录 Lilly 账号的浏览器里）：
#   Cloudflare 控制台 → 存储和数据库 → R2 → 右侧「Manage R2 API Tokens」→ Create API token
#   权限选 Object Read & Write，Buckets 选 scendance-assets（或 All buckets）
#   创建后只会显示一次 Access Key ID / Secret Access Key，复制到下面两行
#
# 用法：
#   node tools/aholo/r2-upload.mjs --hero .cache/aholo/hero --far .cache/aholo/far --env-file .r2.env --dry-run
#   node tools/aholo/r2-upload.mjs --hero .cache/aholo/hero --far .cache/aholo/far --env-file .r2.env
#
# 脚本只在内存里用这些值，任何输出都不会打印密钥。

R2_ACCOUNT_ID=f0273e54d22c215389dd6065a802ddae
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=scendance-assets
