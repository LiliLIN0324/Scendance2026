# Copy to a gitignored .env.edge.local; never put the service role key in a frontend.
PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Reconstruction (vision + planning) still calls DeepSeek directly.
DEEPSEEK_API_KEY=
AI_MAX_REQUEST_CENTS=
# Chat provider for the Binggo agent loop and single-shot proposals (Tokendance gateway).
TOKENDANCE_API_KEY=
# Optional agent place lookup. Enabling sends user place queries to Amap;
# returned points do not establish venue availability, dimensions, price or safety.
AGENT_PLACE_SEARCH_ENABLED=0
AMAP_KEY=
HUNYUAN_API_KEY=
HUNYUAN_API_MODE=tokenhub
GENERATION_MAX_TASK_CENTS=
HUNYUAN_TERMS_URL=
HUNYUAN_TERMS_REVIEWED_AT=
GENERATION_WORKER_SECRET=

# Reconstruction uses its own worker and queue. Reserve includes vision + thinking.
RECONSTRUCTION_MAX_REQUEST_CENTS=200
RECONSTRUCTION_WORKER_SECRET=replace-with-independent-random-secret

# pay-api: 爱猹收会员/额度权益通道（服务端 secret，不进前端）。未配置时
# 权益查询与核销降级到支付宝或本地 mock。base 留空默认 https://pay.watcha.cn。
AICHASHOU_BASE_URL=
AICHASHOU_SANDBOX_API_KEY=
AICHASHOU_ENT_MEMBERSHIP=
AICHASHOU_ENT_QUOTA=
AICHASHOU_ENT_TEAM=
AICHASHOU_ADMIN_OWNER_KEYS=
