# Copy to a gitignored .env.edge.local; never put the service role key in a frontend.
PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
DEEPSEEK_API_KEY=
AI_MAX_REQUEST_CENTS=
HUNYUAN_API_KEY=
HUNYUAN_API_MODE=tokenhub
GENERATION_MAX_TASK_CENTS=
HUNYUAN_TERMS_URL=
HUNYUAN_TERMS_REVIEWED_AT=
GENERATION_WORKER_SECRET=

# Reconstruction uses its own worker and queue. Reserve includes vision + thinking.
RECONSTRUCTION_MAX_REQUEST_CENTS=200
RECONSTRUCTION_WORKER_SECRET=replace-with-independent-random-secret
