{
  "name": "scene-planner-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:integration": "node --experimental-transform-types scripts/local-integration.ts",
    "test:integration": "npm --prefix frontend exec -- vitest run lib/backend-integration.test.ts --root frontend",
    "test": "vitest run tests/",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "check:edge": "deno check --config supabase/functions/deno.json supabase/functions/scene-api/index.ts supabase/functions/generation-worker/index.ts",
    "demo:seed": "node --env-file=.env.local scripts/seed-demo.mjs",
    "smoke:edge": "deno run --config supabase/functions/deno.json scripts/smoke-edge.ts",
    "check:public-model": "deno run --allow-net=api.polyhaven.com,dl.polyhaven.org --config supabase/functions/deno.json scripts/check-public-model.ts",
    "check:config": "node scripts/check-config.mjs --mode core",
    "check:config:full": "node scripts/check-config.mjs --mode full --demo",
    "smoke:cloud": "node --env-file=.env.local scripts/smoke-cloud.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@supabase/supabase-js": "2.117.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.10.1",
    "deno": "2.9.6",
    "supabase": "2.119.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
