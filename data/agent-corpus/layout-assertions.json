  "promptCore": ["GEN-01", "GEN-03", "GEN-04", "GEN-06", "KID-01", "KID-02", "KID-03", "KID-09", "KID-11", "ELD-01", "ELD-06", "ELD-09", "STG-01", "STG-02", "MKT-02", "MKT-06", "CMP-01", "CMP-02", "CMP-03", "EXH-01", "EXH-02"],
  "rules": [
    {
      "id": "GEN-01", "scope": "GEN", "zh": "无障碍通行净宽", "en": "accessible clear width",
      "thresholds": [
        { "label": "室外净宽", "m": 1.5, "cells": 2, "rounding": "ceil", "unit": "m" },
        { "label": "室内净宽", "m": 1.2, "cells": 2, "rounding": "ceil", "unit": "m" }
      ],
      "check": "free_width(any_path) < 1 格 或 室外 < 2 格 → 违规",
      "severity": "hard", "runtime": "static", "sourceLevel": "A",
      "source": "GB 50763-2012 §3.5.1；GB 55019-2021 §2.2.2",
      "conflictWith": [], "promptCore": true,
      "note": "§3.5.1-2 不同印次有 1.50/1.80 两种表述；本表 1.50 为硬底线，1.80 见 GEN-02。"
    },
    {
      "id": "GEN-02", "scope": "GEN", "zh": "主要人流通道", "en": "main circulation width",
      "thresholds": [{ "label": "人流集中处", "m": 1.8, "cells": 2, "rounding": "ceil", "unit": "m" }],
      "check": "free_width(main_path) < 2 格 → 违规",
      "severity": "warn", "runtime": "static", "sourceLevel": "A",
      "source": "GB 50763-2012 §3.5.1-1",
      "conflictWith": [], "promptCore": false
    },
    {
      "id": "GEN-03", "scope": "GEN", "zh": "疏散主通道", "en": "egress main aisle",
      "thresholds": [
        { "label": "小型场地底线", "m": 3, "cells": 3, "rounding": "ceil", "unit": "m" },
        { "label": "5000 人以上主通道", "m": 6, "cells": 6, "rounding": "ceil", "unit": "m" },
        { "label": "5000 人以上辅通道", "m": 3, "cells": 3, "rounding": "ceil", "unit": "m" }
      ],
      "formula": "按人数 3.5–6 m 取值；15000 人以上 8/5 m",
      "check": "free_width(egress) < 3 格 → 违规",
      "severity": "hard", "runtime": "static", "sourceLevel": "B",
      "source": "地方公安口径（郑州、无锡、荆州）；GB 50016-2014 §5.5.18",
      "conflictWith": ["EXH-08", "KID-11"], "promptCore": true,
      "note": "地方口径按项目所在城市替换；B 级不得称国标。"
    },
    {
      "id": "GEN-04", "scope": "GEN", "zh": "安全出口数量", "en": "exit count",
      "thresholds": [{ "label": "出口数下限", "count": 2, "unit": "count" }],
      "formula": "N≥10000 人时 ≥4 个，且直通场外",
      "check": "count(exit) < 2 或 (N≥10000 且 count(exit)<4) → 违规",
      "severity": "hard", "runtime": "static", "sourceLevel": "B",
      "source": "地方公安口径；《大型群众性活动安全管理条例》§11",
      "conflictWith": [], "promptCore": true
    },
    {
      "id": "GEN-05", "scope": "GEN", "zh": "消防设施净空", "en": "hydrant clearance",
      "thresholds": [{ "label": "净空", "m": 1.5, "cells": 2, "rounding": "ceil", "unit": "m" }],
      "check": "gap(any_object, hydrant) < 2 格 → 违规",
      "severity": "hard", "runtime": "static", "sourceLevel": "A",
      "source": "GB 50016-2014 §8.1；常规消防检查口径",
      "conflictWith": [], "promptCore": false
    },
    {
      "id": "GEN-06", "scope": "GEN", "zh": "垂直净空", "en": "clear height",
      "thresholds": [{ "label": "通道及悬挂物底边", "m": 2.2, "cells": 3, "rounding": "ceil", "unit": "m" }],
      "check": "clear_height(path) < 3 格 → 违规",
      "severity": "hard", "runtime": "static", "sourceLevel": "A",
      "source": "GB/T 36731-2018 §6.2.6.1；GB 50763-2012 §3.5.2-4",
      "conflictWith": [], "promptCore": true,
      "note": "标识底边允许 2.00 m；其余按 2.20 m。"
    },
    {
      "id": "GEN-07", "scope": "GEN", "zh": "临时设施退距", "en": "temporary setback",
      "thresholds": [{ "label": "距建筑外墙", "m": 3, "cells": 3, "rounding": "ceil", "unit": "m" }],
      "check": "gap(temp, building) < 3 格 → 违规",
      "severity": "warn", "runtime": "static", "sourceLevel": "C",
      "source": "经验值（C）+ 消防车道禁占",
      "conflictWith": [], "promptCore": false,
      "note": "C 级，对外只能表述为建议值。"
    },
    {
      "id": "GEN-08", "scope": "GEN", "zh": "人员密度换算", "en": "occupancy factor",
      "thresholds": [
        { "label": "展览厅", "value": 0.75, "unit": "person_per_m2" },
        { "label": "无座活动人均面积", "value": 1.0, "unit": "m2_per_person" }
      ],
      "check": "density(zone) > 0.75（展览）或 area/capacity < 1.0（活动）→ 违规",
      "severity": "hard", "runtime": "static", "sourceLevel": "A",
      "source": "GB 50016-2014 表 5.5.21-2；地方公安口径（深圳、无锡）",
      "conflictWith": [], "promptCore": false
    },

    {
